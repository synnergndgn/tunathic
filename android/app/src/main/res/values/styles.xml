<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown while the process starts. The warm ivory launch surface matches
         the first Flutter frame so boot never flashes black or cold white. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Applied once the process has started and while the Flutter UI
         initializes. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/studio_backdrop</item>
    </style>
</resources>
